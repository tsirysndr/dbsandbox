-- | The command line, parsed with optparse. Every sandbox tool shares this
-- | module; the profile only changes names in the help text.
module Sbx.Cli
  ( Command(..)
  , RootCommand(..)
  , StartOpts
  , BranchOpts
  , MigrateCmd(..)
  , parseRoot
  , parseCommand
  ) where

import Prelude
import Control.Alt ((<|>))
import Data.Array as Array
import Data.Either (Either(..))
import Data.Foldable (fold)
import Data.Maybe (Maybe(..), maybe, optional)
import Effect (Effect)
import Options.Applicative (Parser, ReadM, argument, command, commandGroup, customExecParser, eitherReader, footer, flag', forwardOptions, fullDesc, header, help, helper, hidden, info, infoOption, int, long, many, metavar, option, prefs, progDesc, short, showHelpOnEmpty, strArgument, strOption, subparser, switch, value)
import Sbx.Database.Profiles as Profiles
import Sbx.Database.Profile (Os(..), Profile, parseOs)
import Sbx.Cli.GlobalCommand as Global

data RootCommand = Database Profile Command | Global Global.GlobalCommand

type StartOpts =
  { os :: Maybe Os
  , version :: Maybe String
  , port :: Maybe Int
  , user :: Maybe String
  , password :: Maybe String
  , db :: Maybe String
  , cpus :: Maybe Int
  , mem :: Maybe Int
  , branch :: Maybe String
  , size :: Maybe String
  , detach :: Boolean -- ^ quiet start: no VM console or provisioning output
  }

type BranchOpts = { name :: Maybe String, arg :: Maybe String, delete :: Boolean, from :: Maybe String, port :: Maybe Int }

data Command
  = OnBranch String Command
  | Start StartOpts
  | Stop
  | Status
  | Shell
  | Exec { tty :: Boolean, command :: Array String }
  | Logs { follow :: Boolean, boot :: Boolean }
  | Branch BranchOpts
  | Checkout { name :: String, create :: Boolean }
  | Url
  | Client (Array String)
  | Api (Array String)
  | Token
  | Fancy (Array String)
  | Ui { port :: Maybe Int, noOpen :: Boolean }
  | Studio { port :: Int, host :: String, noOpen :: Boolean }
  | Drizzle (Array String)
  | Doctor
  | Destroy { yes :: Boolean }
  | Migrate MigrateCmd
  | Tool (Array String)
  | Setup

-- | The migration workflow (pgroll's), with the sandbox URL and the
-- | migrations directory filled in.
data MigrateCmd
  = MigrateInit
  | MigrateNew { name :: String, empty :: Boolean, json :: Boolean }
  | MigrateUp { dir :: Maybe String, keepOpen :: Boolean }
  | MigrateStart { file :: String, complete :: Boolean }
  | MigrateComplete
  | MigrateRollback
  | MigrateStatus
  | MigratePull { dir :: Maybe String }
  | MigrateBaseline { version :: String, dir :: Maybe String }

osReader :: Profile -> ReadM Os
osReader p = eitherReader \s -> case parseOs s of
  Just os | p.linuxOnly && os /= Linux -> Left (p.cli <> " runs on Linux only (a container in the shared Docker engine VM)")
  Just os -> Right os
  Nothing -> Left ((if p.linuxOnly then "expected linux, got '" else "expected linux, freebsd or netbsd, got '") <> s <> "'")

startP :: Profile -> Parser Command
startP p = ado
  os <- optional $ argument (osReader p) $ fold
    [ metavar (if p.linuxOnly then "linux" else "linux|freebsd|netbsd")
    , help (if p.linuxOnly then "Guest OS: linux only, a container in the shared Docker engine VM" else "Guest OS (default: linux, a container in the shared Docker engine VM; the BSDs get a VM each)")
    ]
  version <- optional $ strArgument $ fold
    [ metavar "VERSION", help ("Linux: image tag, e.g. " <> p.defaultTag <> ", or a full image reference (default: " <> p.defaultTag <> ")" <> p.versionNote <> (if p.linuxOnly then "" else ". FreeBSD/NetBSD: OS release, e.g. 15.1 or 10.1 (default: latest)")) ]
  port <- optional $ option int $ fold
    [ long "port", short 'p', metavar "PORT", help ("Host port forwarded to " <> p.product <> " (default: " <> show p.guestPort <> ")") ]
  user <- credential "user" ("Superuser name (default: " <> p.defaults.user <> ")")
  password <- credential "password" (if p.hasToken then "Authentication token / API key (generated by default)" else "Its password (default: " <> p.defaults.password <> ")")
  db <-
    if not p.hasDatabase then pure Nothing
    else optional $ strOption $ fold
      [ long "db", metavar "NAME", help ("Database created on first start (default: " <> p.defaults.db <> ")") ]
  cpus <- optional $ option int $ fold [ long "cpus", metavar "N", help "vCPUs of the VM (BSD guests; default: 2). Not applied on Linux, where the shared engine VM is sized with `bsdkrun docker start`" ]
  mem <- optional $ option int $ fold [ long "mem", metavar "MIB", help "Guest RAM in MiB (BSD guests; default: 1024). Not applied on Linux" ]
  branch <- optional $ strOption $ fold
    [ long "branch", short 'b', metavar "BRANCH", help "Data branch to mount (default: the current one, main at first)" ]
  size <- optional $ strOption $ fold
    [ long "size", metavar "SIZE", help "Data volume size when it is created, e.g. 10G (sparse; default: 10G)" ]
  detach <- switch $ fold
    [ long "detach", short 'd', help "Quiet start: do not stream the VM console and the provisioning output" ]
  in Start { os, version, port, user, password, db, cpus, mem, branch, size, detach }
  where
  credential name doc
    | p.hasCredentials || (name == "password" && p.hasToken) = optional $ strOption $ fold [ long name, metavar (if name == "user" then "NAME" else "SECRET"), help doc ]
    | otherwise = pure Nothing

logsP :: Parser Command
logsP = ado
  follow <- switch $ fold [ long "follow", short 'f', help "Keep streaming the console" ]
  boot <- switch $ fold [ long "boot", help "bsdkrun's own boot log instead of the guest console" ]
  in Logs { follow, boot }

branchP :: Parser Command
branchP = ado
  delete <- switch $ fold [ long "delete", short 'd', help "Delete NAME instead of creating it" ]
  from <- optional $ strOption $ fold [ long "from", metavar "BRANCH", help "Branch to fork from (default: the current one)" ]
  name <- optional $ strArgument $ fold [ metavar "NAME", help "Branch to create (or delete with -d). Without it, list branches. Also: `ls`, `rm NAME`" ]
  arg <- optional $ strArgument $ fold [ metavar "ARG", help "The branch for `rm` / `delete`" ]
  port <- optional $ option int $ fold [ long "port", short 'p', metavar "PORT", help "Parallel server port (default: automatically choose a free, unreserved port)" ]
  in Branch { name, arg, delete, from, port }

checkoutP :: Parser Command
checkoutP = ado
  create <- switch $ fold [ long "create", short 'b', help "Create NAME from the current branch first" ]
  name <- strArgument $ fold [ metavar "BRANCH", help "Branch to mount as the data directory" ]
  in Checkout { name, create }

studioP :: Parser Command
studioP = ado
  port <- option int $ fold [ long "port", metavar "PORT", value 4983, help "Port Drizzle Studio's server listens on (default: 4983)" ]
  host <- strOption $ fold [ long "host", metavar "HOST", value "127.0.0.1", help "Address it binds (default: 127.0.0.1)" ]
  noOpen <- switch $ fold [ long "no-open", help "Print the URL without opening a browser" ]
  in Studio { port, host, noOpen }

uiP :: Parser Command
uiP = ado
  port <- optional $ option int $ fold [ long "port", metavar "PORT", help "Host UI port (default: first free port from 4213)" ]
  noOpen <- switch $ fold [ long "no-open", help "Print the URL without opening a browser" ]
  in Ui { port, noOpen }

execP :: Parser Command
execP = ado
  tty <- switch $ fold [ long "tty", short 't', help "Allocate a pseudo-terminal (for shells, editors and prompts)" ]
  command <- many $ strArgument $ fold [ metavar "CMD...", help "The command and its arguments, run as root through the guest agent" ]
  in Exec { tty, command: Array.fromFoldable command }

destroyP :: Parser Command
destroyP = ado
  yes <- switch $ fold [ long "yes", short 'y', help "Do not ask for confirmation" ]
  in Destroy { yes }

migrateP :: String -> Parser Command
migrateP dir = Migrate <$> subparser
  ( fold
      [ command "init" $ info (pure MigrateInit) $ progDesc "Initialise the migration tool's schema in the sandbox database"
      , command "new" $ info (helper <*> newP) $ progDesc ("Create a migration file in " <> dir <> "/ (interactive unless --empty)")
      , command "up" $ info (helper <*> upP) $ progDesc ("Apply the outstanding migrations from " <> dir <> "/ and complete them")
      , command "start" $ info (helper <*> startMP) $ progDesc "Start one migration file: old and new schema versions coexist until `complete`"
      , command "complete" $ info (pure MigrateComplete) $ progDesc "Complete the migration in progress"
      , command "rollback" $ info (pure MigrateRollback) $ progDesc "Roll back the migration in progress"
      , command "status" $ info (pure MigrateStatus) $ progDesc "Show the current schema version and migration state"
      , command "pull" $ info (helper <*> pullP) $ progDesc ("Write the sandbox's migration history to " <> dir <> "/")
      , command "baseline" $ info (helper <*> baselineP) $ progDesc "Record the current schema as a baseline migration VERSION"
      ]
  )
  where
  dirArg = optional $ strArgument $ fold [ metavar "DIR", help ("Migrations directory (default: " <> dir <> ")") ]
  newP = ado
    name <- strArgument $ fold [ metavar "NAME", help "Migration name, e.g. add_users" ]
    empty <- switch $ fold [ long "empty", short 'e', help "Write an empty migration instead of asking for operations" ]
    json <- switch $ fold [ long "json", help "JSON instead of YAML" ]
    in MigrateNew { name, empty, json }
  upP = ado
    dir' <- dirArg
    keepOpen <- switch $ fold [ long "keep-open", help "Leave the last migration started but not completed" ]
    in MigrateUp { dir: dir', keepOpen }
  startMP = ado
    file <- strArgument $ fold [ metavar "FILE", help "Migration file" ]
    complete <- switch $ fold [ long "complete", short 'c', help "Complete it right away" ]
    in MigrateStart { file, complete }
  pullP = ado
    dir' <- dirArg
    in MigratePull { dir: dir' }
  baselineP = ado
    version <- strArgument $ fold [ metavar "VERSION", help "Baseline version name, e.g. 01_initial" ]
    dir' <- dirArg
    in MigrateBaseline { version, dir: dir' }

clientP :: Parser Command
clientP = Client <<< Array.fromFoldable <$> many (strArgument (metavar "SQL_ARGS..."))

fancyP :: Parser Command
fancyP = Fancy <<< Array.fromFoldable <$> many (strArgument (metavar "ARGS..."))

commands :: Profile -> Parser Command
commands p = case p.migrations of
  Nothing -> base
  Just m -> base <|> migrationCommands m
  where
  base =
    subparser
      ( fold
          ( [ command "start" $ info (helper <*> startP p) $ fold
                [ progDesc ("Start the database, creating its runtime and ZFS volume on first run")
                , footer ((if p.hasToken then "The authentication token is generated by default; --password configures it. " else if p.hasCredentials then "Credentials and the database are set when data is first initialised. " else "Data persists on the selected ZFS branch. ") <> p.cli <> " start linux " <> p.defaultTag <> if p.linuxOnly then "" else ", " <> p.cli <> " start freebsd 15.1")
                ]
            , command "stop" $ info (pure Stop) $ progDesc "Stop this database instance (data stays on its branch)"
            , command "status" $ info (pure Status) $ progDesc "Show the VM, the mounted branch and the connection URL"
            , command "ssh" $ info (pure Shell) $ progDesc "Open a shell in the VM, or in the container on Linux (alias: shell)"
            , command "exec" $ info (helper <*> execP) $ fold
                [ progDesc "Run a command in the VM with your stdin, stdout and stderr bound to it"
                , footer ("Example: " <> p.cli <> " exec -t sh, " <> p.cli <> " exec " <> "psql -U postgres" <> " -c \"select 1\"")
                , forwardOptions
                ]
            , command "log" $ info (helper <*> logsP) $ progDesc "Show the VM console log, -f to follow (alias: logs)"
            , command "branch" $ info (helper <*> branchP) $ fold
                [ progDesc "List branches, fork a parallel instance, or delete one"
                , footer ("Like git: `" <> p.cli <> " branch` (or `branch ls`) lists, `" <> p.cli <> " branch NAME` forks and starts a parallel server from the current branch, `" <> p.cli <> " branch -d NAME` (or `branch rm NAME`) deletes, `" <> p.cli <> " checkout NAME` switches.")
                ]
            , command "checkout" $ info (helper <*> checkoutP) $ progDesc "Select a parallel server or switch the parent data branch; -b creates a data branch (alias: switch)"
            , command p.clientName $ info (helper <*> clientP) $ fold [ progDesc ("Open " <> p.clientName <> " on the sandbox database"), forwardOptions ]
            , command p.fancy.name $ info (helper <*> fancyP) $ fold [ progDesc ("Open " <> p.fancy.name <> " on the sandbox database"), forwardOptions ]
            , command "url" $ info (pure Url) $ progDesc "Print the connection URL"
            , command "doctor" $ info (pure Doctor) $ progDesc ("Check bsdkrun, the hypervisor and optional database tools: " <> p.fancy.name <> maybe "" (\m -> " and " <> m.name) p.migrations)
            , command "destroy" $ info (helper <*> destroyP) $ progDesc "Remove the VM and the data volume with every branch (asks first)"
            ] <> (if p.driver == "quack" then [ command "ui" $ info (helper <*> uiP) $ progDesc "Start DuckDB's web UI on this Linux branch; Ctrl-C closes it" ] else [])
              <>
                ( if p.dialect == "" then []
                  else
                    [ command "studio" $ info (helper <*> studioP) $ progDesc "Open Drizzle Studio on the sandbox database"
                    , command "drizzle" $ info (helper <*> (Drizzle <<< Array.fromFoldable <$> many (strArgument (metavar "ARGS...")))) $ fold
                        [ progDesc "Run drizzle-kit with DATABASE_URL pointing at the sandbox"
                        , footer (p.cli <> " drizzle push, " <> p.cli <> " drizzle generate, " <> p.cli <> " drizzle migrate. Your drizzle.config.ts can read process.env.DATABASE_URL; without one, a config for the sandbox is supplied.")
                        , forwardOptions
                        ]
                    ]
                )
              <>
                ( case p.http of
                    Just _ | p.clientName /= "api" -> [ command "api" $ info (helper <*> (Api <<< Array.fromFoldable <$> many (strArgument (metavar "[METHOD] /PATH [BODY]")))) $ fold [ progDesc "Send an HTTP request to this branch", forwardOptions ] ]
                    _ -> []
                )
              <> (if p.hasToken then [ command "token" $ info (pure Token) $ progDesc "Print the authentication token / API key" ] else [])
          )
      )
      <|> subparser
        ( fold
            ( map (\alias -> command alias $ info (helper <*> clientP) $ progDesc ("Alias of " <> p.clientName)) p.clientAliases <>
                [ command "shell" $ info (pure Shell) $ progDesc "Alias of ssh"
                , command "logs" $ info (helper <*> logsP) $ progDesc "Alias of log"
                , command "switch" $ info (helper <*> checkoutP) $ progDesc "Alias of checkout"
                , commandGroup "Aliases:"
                , hidden
                ]
            )
        )
  migrationCommands m = subparser
    ( fold
        [ command "migrate" $ info (helper <*> migrateP m.dir) $ fold
            [ progDesc ("Schema migrations with " <> m.name <> ": init, new, up, start, complete, rollback, status, pull, baseline")
            , footer ("Pairs with branches: `" <> p.cli <> " checkout -b try-migration`, `" <> p.cli <> " migrate up`, look around, `" <> p.cli <> " checkout main`.")
            ]
        , command m.name $ info (helper <*> (Tool <<< Array.fromFoldable <$> many (strArgument (metavar "ARGS...")))) $ fold
            [ progDesc ("Run " <> m.name <> " with the sandbox URL (any " <> m.name <> " arguments)")
            , forwardOptions
            ]
        , command "setup" $ info (pure Setup) $ progDesc ("Install " <> m.name <> " on this host (Homebrew, or its release binary into ~/.local/bin) and initialise it in the sandbox")
        , commandGroup "Migrations:"
        ]
    )

-- | The out-of-the-box choices, for the top-level help.
defaultsLine :: Profile -> String
defaultsLine p = "Defaults: linux " <> p.image p.defaultTag <> ", host port " <> show p.guestPort <> " on 127.0.0.1, 2 vCPU, 1024 MiB, data volume 10G"
  <> (if p.hasCredentials then ", user " <> p.defaults.user <> ", password " <> p.defaults.password <> ", database " <> p.defaults.db else "")
  <> ". `start --help` lists the flags that change them."

parseCommand :: Profile -> String -> Effect Command
parseCommand p version = customExecParser (prefs showHelpOnEmpty) $ info (helper <*> versionOption <*> scopedCommands) $ fold
  [ fullDesc
  , header (p.cli <> " — " <> p.product <> " in a bsdkrun microVM, with branchable data")
  , progDesc ("One " <> p.product <> " server per sandbox, running in a lightweight VM. Its data directory is a ZFS branch: fork it copy-on-write, switch between branches, throw them away. " <> (if p.dialect == "" then "" else " Drizzle Studio and drizzle-kit are wired to it."))
  , footer (defaultsLine p)
  ]
  where
  scopedCommands = ado
    selected <- optional $ strOption $ fold [ long "branch", metavar "NAME", help "Target a parallel branch instance (place before the command)" ]
    cmd <- commands p
    in maybe cmd (flip OnBranch cmd) selected
  versionOption = infoOption ("dbsandbox " <> version) $ fold [ long "version", help "Show the version" ]

parseRoot :: String -> Effect RootCommand
parseRoot version = customExecParser (prefs showHelpOnEmpty) $ info (helper <*> versionOption <*> noColorOption <*> databases) $ fold
  [ fullDesc
  , header "dbsandbox — databases with parallel ZFS branches"
  , progDesc "Run database, search and authorization services in bsdkrun sandboxes. branch NAME starts an independent copy-on-write instance."
  , footer "Examples: dbsandbox postgres start; dbsandbox duckdb branch feature; dbsandbox sqlite --branch feature url. Disable colors with --no-color or NO_COLOR=1."
  ]
  where
  versionOption = infoOption ("dbsandbox " <> version) (long "version" <> help "Show the version")
  noColorOption = identity <$ switch (long "no-color" <> help "Disable colors (also honors NO_COLOR)")
  databases = subparser (fold (global <> map database Profiles.all)) <|> subparser
    (fold (Array.mapMaybe alias [ "postgresql", "pg", "libsql", "timescaledb", "mongo", "cockroach", "scylla", "yugabyte" ]) <> hidden <> commandGroup "Aliases:")
  alias name = case Profiles.find name of
    Nothing -> Nothing
    Just db -> Just (command name $ info (helper <*> selected db.profile) (progDesc db.profile.product))
  database db = command db.name $ info (helper <*> selected db.profile) (progDesc db.profile.product)
  selected p = ado
    branch <- optional $ strOption $ fold [ long "branch", metavar "NAME", help "Target a parallel instance without changing checkout" ]
    cmd <- commands p
    in Database p (maybe cmd (flip OnBranch cmd) branch)
  json = switch (long "json" <> help "Print JSON")
  global =
    [ command "ps" $ info
        ( helper <*>
            ( ado
                all <- switch (long "all" <> short 'a' <> help "Include stopped sandboxes")
                jsonOutput <- json
                in Global (Global.Ps { all, json: jsonOutput })
            )
        )
        (progDesc "List database servers and branches across all databases")
    , command "databases" $ info (helper <*> (Global <<< Global.Databases <<< { json: _ } <$> json)) (progDesc "List supported databases, default versions and guest operating systems")
    , command "doctor" $ info (helper <*> (Global <<< Global.Doctor <<< { json: _ } <$> json)) (progDesc "Check the runtime, virtualization and host dependencies")
    , command "stop" $ info (helper <*> (Global Global.StopAll <$ flag' unit (long "all" <> help "Stop every configured database server, preserving data"))) (progDesc "Stop all database servers (requires --all)")
    , command "engine" $ info (helper <*> subparser (command "status" (info (helper <*> (Global <<< Global.EngineStatus <<< { json: _ } <$> json)) (progDesc "Show shared VM CPU, memory and disk usage")))) (progDesc "Inspect the shared Docker engine VM")
    , command "completion" $ info (helper <*> (Global <<< Global.Completion <$> argument (eitherReader shell) (metavar "bash|zsh|fish"))) (progDesc "Generate shell completions")
    , command "tui" $ info (helper <*> pure (Global Global.Tui)) (progDesc "Interactive terminal dashboard with fuzzy branch search and keyboard shortcuts")
    , command "ui" $ info
        ( helper <*>
            ( ado
                port <- optional $ option int (long "port" <> metavar "PORT" <> help "Dashboard port (default: first free port from 8787)")
                noOpen <- switch (long "no-open" <> help "Print the URL without opening a browser")
                in Global (Global.Dashboard { port, noOpen })
            )
        )
        (progDesc "Open the local dashboard for servers, branches and database UIs")
    ]
  shell name = if Array.elem name [ "bash", "zsh", "fish" ] then Right name else Left "Choose bash, zsh or fish"
