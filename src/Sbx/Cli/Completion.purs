-- | Completion scripts are generated from the same database profiles as help.
module Sbx.Cli.Completion (generate, databaseCommands) where

import Prelude
import Data.Array as A
import Data.Maybe (Maybe(..), maybe)
import Data.String as S
import Sbx.Database.Profile (Profile)
import Sbx.Database.Profiles as Profiles

databaseCommands :: Profile -> Array String
databaseCommands p = A.nub $
  [ "start", "stop", "status", "ssh", "shell", "exec", "log", "logs", "branch", "checkout", "switch", "url", "doctor", "destroy", p.clientName, p.fancy.name ]
    <> p.clientAliases
    <> (if p.dialect == "" then [] else [ "studio", "drizzle" ])
    <> (if p.driver == "quack" then [ "ui" ] else [])
    <> (if p.hasToken then [ "token" ] else [])
    <>
      ( case p.http of
          Nothing -> []
          Just _ -> [ "api" ]
      )
    <> maybe [] (\m -> [ "migrate", m.name, "setup" ]) p.migrations

roots :: String
roots = S.joinWith " " ([ "ps", "databases", "doctor", "stop", "engine", "completion", "ui", "tui" ] <> map _.name Profiles.all <> [ "postgresql", "pg", "libsql", "timescaledb", "mongo", "cockroach", "scylla", "yugabyte" ])

flags :: String
flags = "--help --version --no-color --branch --port --host --no-open --all --json --user --password --db --cpus --mem --size --detach --from --delete --yes --follow --boot --tty --create"

cases :: String
cases = S.joinWith "\n" $ map (\db -> "    " <> db.name <> ") opts='" <> S.joinWith " " (databaseCommands db.profile) <> " " <> flags <> "' ;; ") Profiles.all

aliases :: Array { alias :: String, name :: String }
aliases = [ { alias: "pg", name: "postgres" }, { alias: "postgresql", name: "postgres" }, { alias: "libsql", name: "sqlite" }, { alias: "timescaledb", name: "timescale" }, { alias: "mongo", name: "mongodb" }, { alias: "cockroach", name: "cockroachdb" }, { alias: "scylla", name: "scylladb" }, { alias: "yugabyte", name: "yugabytedb" } ]

normalize :: String -> String
normalize variable = S.joinWith "\n" (map (\a -> "    " <> a.alias <> ") " <> variable <> "=" <> a.name <> " ;; ") aliases)

generate :: String -> String
generate "bash" = S.joinWith "\n"
  [ "# Generated by dbsandbox completion bash"
  , "_dbsandbox_complete() {"
  , "  local cur=\"${COMP_WORDS[COMP_CWORD]}\" root=\"${COMP_WORDS[1]}\" opts"
  , "  if (( COMP_CWORD == 1 )); then opts='" <> roots <> " --help --version --no-color'; else"
  , "  case \"$root\" in"
  , normalize "root"
  , "  esac"
  , "  case \"$root\" in"
  , "    engine) opts='status --help --json' ;;"
  , "    completion) opts='bash zsh fish --help' ;;"
  , "    ps|databases|doctor) opts='--all --json --help' ;;"
  , "    stop) opts='--all --help' ;;"
  , "    ui) opts='--port --no-open --help' ;;"
  , cases
  , "    *) opts='--help' ;;"
  , "  esac; fi"
  , "  COMPREPLY=( $(compgen -W \"$opts\" -- \"$cur\") )"
  , "}"
  , "complete -F _dbsandbox_complete dbsandbox"
  , ""
  ]
generate "zsh" = S.joinWith "\n"
  [ "#compdef dbsandbox"
  , "_dbsandbox() {"
  , "  local root=\"$words[2]\" opts"
  , "  if (( CURRENT == 2 )); then opts='" <> roots <> " --help --version --no-color'; else"
  , "  case \"$root\" in"
  , normalize "root"
  , "  esac"
  , "  case \"$root\" in"
  , "    engine) opts='status --help --json' ;;"
  , "    completion) opts='bash zsh fish --help' ;;"
  , "    ps|databases|doctor) opts='--all --json --help' ;;"
  , "    stop) opts='--all --help' ;;"
  , "    ui) opts='--port --no-open --help' ;;"
  , cases
  , "    *) opts='--help' ;;"
  , "  esac; fi"
  , "  compadd -- ${(z)opts}"
  , "}"
  , "compdef _dbsandbox dbsandbox"
  , ""
  ]
generate "fish" = S.joinWith "\n" $
  [ "# Generated by dbsandbox completion fish"
  , "complete -c dbsandbox -f"
  , "complete -c dbsandbox -n '__fish_use_subcommand' -a '" <> roots <> "'"
  , "complete -c dbsandbox -n '__fish_seen_subcommand_from engine' -a status"
  , "complete -c dbsandbox -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'"
  , "complete -c dbsandbox -l help -s h"
  , "complete -c dbsandbox -l version"
  , "complete -c dbsandbox -n '__fish_seen_subcommand_from ps stop' -l all"
  , "complete -c dbsandbox -n '__fish_seen_subcommand_from ps databases doctor engine' -l json"
  , "complete -c dbsandbox -l no-open"
  , "complete -c dbsandbox -l branch -x"
  , "complete -c dbsandbox -l port -x"
  , "complete -c dbsandbox -l host -x"
  ] <> map (\db -> "complete -c dbsandbox -n '__fish_seen_subcommand_from " <> db.name <> "' -a '" <> S.joinWith " " (databaseCommands db.profile) <> "'") Profiles.all
    <> A.mapMaybe (\a -> Profiles.find a.name <#> \db -> "complete -c dbsandbox -n '__fish_seen_subcommand_from " <> a.alias <> "' -a '" <> S.joinWith " " (databaseCommands db.profile) <> "'") aliases
    <> [ "" ]
generate _ = ""
